# ============================================================
# انسخ هذا الملف إلى .env (محلياً) أو أضف المتغيرات في لوحة Render/Vercel
# ============================================================

# --- قاعدة البيانات (Supabase) ---
# DATABASE_URL: رابط الـ Transaction pooler (المنفذ 6543) - يستخدمه التطبيق
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL: رابط الـ Session pooler (المنفذ 5432) - يستخدمه prisma db push فقط
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- التطبيق ---
# الرابط العام للموقع بدون / في النهاية (مهم جداً لروابط الـ webhook والرجوع من بوابة الدفع)
APP_URL="http://localhost:3000"
# اتركه فارغاً إذا كان الـ Socket.io يعمل على نفس الدومين (Render). يُملأ فقط إذا كان السيرفر على دومين آخر.
NEXT_PUBLIC_SOCKET_URL=""
# سر توقيع الجلسات (32 حرفاً على الأقل). توليد: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# سر يُضاف لرابط webhook الخاص بـ FIB. توليد: openssl rand -hex 24
WEBHOOK_SECRET="change-me-random-hex"

# --- الأعمال ---
PLATFORM_FEE_PERCENT=30
MIN_DONATION_IQD=1000
MAX_DONATION_IQD=5000000
MIN_PAYOUT_IQD=25000

# بوابة تجريبية لاختبار الدفع بدون أموال. ضعها false في الإنتاج الحقيقي.
ALLOW_MOCK_PAYMENTS=true

# --- FIB (First Iraqi Bank) ---
FIB_BASE_URL="https://fib.stage.fib.iq"
FIB_AUTH_PATH="/auth/realms/fib-online-shop/protocol/openid-connect/token"
FIB_CLIENT_ID=""
FIB_CLIENT_SECRET=""

# --- ZainCash ---
ZAINCASH_BASE_URL="https://pg-api-uat.zaincash.iq"
ZAINCASH_CLIENT_ID=""
ZAINCASH_CLIENT_SECRET=""
ZAINCASH_API_KEY=""
ZAINCASH_SERVICE_TYPE=""

# --- حساب الأدمن (يُنشأ عند تشغيل: npm run db:seed) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe12345"
